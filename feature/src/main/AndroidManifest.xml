<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".FeatureActivity"
            android:exported="false"
            android:label="@string/title_activity_feature"
            android:theme="@style/Theme.FeatureModule" />

        <provider
            android:name="com.santimattius.android.koin.startup.KoinBackgroundInitializerProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:process=":koin-background-initializer"
            android:exported="false"
            tools:node="merge">

            <meta-data
                android:name="com.santimattius.android.feature.FeatureInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>